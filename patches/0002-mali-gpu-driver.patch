+	mali-utgard-sc8830-r4p1.tar.gz
 "
 builddir="$srcdir/$_repository-$_commit"
 _outdir="out"
 
 prepare() {
 	default_prepare
+
+	# --- Mali-400 Utgard GPU driver (sc8830 platform, r4p1) ---
+	# From codeworkx/android_kernel_samsung_gtelwifi @ cm-11.0 (commit 60871e9801b0);
+	# factory-matched to the stock libGLES_mali.so r4p1 blob. Injected here because the
+	# pmsourcedump tree was stripped of drivers/gpu/mali. See CLAUDE.md "THE ULTIMATE HACK".
+	# MUST run BEFORE downstreamkernel_prepare: that does `make oldconfig`, which would drop
+	# CONFIG_MALI400=y as an unknown symbol unless mali/Kconfig is already sourced.
+	cp -r "$srcdir"/mali "$builddir"/drivers/gpu/mali
+	# hook into the gpu build (mirror codeworkx's integration)
+	grep -q ' mali/' "$builddir"/drivers/gpu/Makefile || \
+		sed -i 's|^\(obj-y.*sprd_iommu/\)|\1 mali/|' "$builddir"/drivers/gpu/Makefile
+	grep -q 'gpu/mali/Kconfig' "$builddir"/drivers/Kconfig || \
+		sed -i '\|^source "drivers/video/Kconfig"|a source "drivers/gpu/mali/Kconfig"' "$builddir"/drivers/Kconfig
+
 	. downstreamkernel_prepare
 }
 
