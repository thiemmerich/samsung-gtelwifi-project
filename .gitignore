# The pmaports clone is a reproducible build input, NOT our code.
# Re-create it with scripts/setup-pmaports.sh. Never commit it.
/pmaports/

# pmbootstrap tool clone (installed via git, symlinked to ~/.local/bin). Not our code.
/pmbootstrap/

# Stock recovery firmware (~1.6G, Samsung's, not ours). Keep local, never commit.
/old-firmware/

# Build artifacts / images
*.img
*.tar.gz
*.zip

# EXCEPTION: the Mali GPU driver source tarball IS ours to vendor (small, GPL, required by
# setup-pmaports.sh + patches/0002). Keep it tracked despite the *.tar.gz rule above.
!/vendor/mali-utgard-sc8830-r4p1.tar.gz

# OS cruft
.DS_Store
